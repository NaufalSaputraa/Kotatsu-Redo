<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="72dp"
	android:clipChildren="false">

	<View
		android:id="@+id/view_cover"
		android:layout_width="40dp"
		android:layout_height="40dp"
		android:layout_marginStart="8dp"
		android:layout_marginTop="16dp"
		android:layout_marginBottom="16dp"
		android:background="@drawable/skeleton_placeholder"
		app:layout_constraintBottom_toBottomOf="parent"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintTop_toTopOf="parent" />

	<View
		android:id="@+id/view_title"
		android:layout_width="140dp"
		android:layout_height="16dp"
		android:layout_marginStart="16dp"
		android:background="@drawable/skeleton_placeholder"
		app:layout_constraintBottom_toTopOf="@+id/view_summary"
		app:layout_constraintStart_toEndOf="@+id/view_cover"
		app:layout_constraintTop_toTopOf="@+id/view_cover" />

	<View
		android:id="@+id/view_summary"
		android:layout_width="220dp"
		android:layout_height="12dp"
		android:layout_marginStart="16dp"
		android:background="@drawable/skeleton_placeholder"
		app:layout_constraintBottom_toBottomOf="@+id/view_cover"
		app:layout_constraintStart_toEndOf="@+id/view_cover"
		app:layout_constraintTop_toBottomOf="@+id/view_title" />

</androidx.constraintlayout.widget.ConstraintLayout>
